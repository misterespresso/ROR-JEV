<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ROR-JEV fork of Rainflayer, base commit 01137e5 (declares 1.1.1). See docs/09-FORK-BASE.md.

    Build 0 changes ONE thing relative to upstream: where reference assemblies come from.
    The C# sources are byte-identical to 01137e5, so if this build behaves differently from
    the stock DLL, the difference is attributable to the build rather than the code.

    What changed, and why:
      * BepInEx 6 names (BepInEx.Core, BepInEx.Unity.Mono) -> BepInEx 5 (BepInEx.dll).
        The published DLL references BepInEx 5 and every committed csproj referenced 6, so
        upstream's releases were built from a project file that was never committed (E2).
        The source uses no BepInEx-6-only API (E3), so this is a path change, not a port.
      * libs\ -> the real install locations, via overridable properties. Proprietary game
        assemblies are REFERENCED, never copied into the repository.
      * Conditional references are now required. A missing input used to be skipped silently,
        producing a different DLL from the same source; now it fails the build by name.
      * Deterministic output with local paths mapped away, so the DLL's hash depends on the
        inputs and not on whose machine built it.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsPublishable>False</IsPublishable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>Rainflayer</RootNamespace>
    <AssemblyName>Rainflayer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/mod</PathMap>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Input locations. Override on the command line if your install differs:
       dotnet build -p:RoR2Managed="D:\...\Managed" -p:R2Profile="...\profiles\Other" -->
  <PropertyGroup>
    <RoR2Managed Condition="'$(RoR2Managed)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2\Risk of Rain 2_Data\Managed</RoR2Managed>
    <R2Profile Condition="'$(R2Profile)' == ''">$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Jev</R2Profile>
    <BepInExCore>$(R2Profile)\BepInEx\core</BepInExCore>
    <!-- Generated by HookGenPatcher from the CURRENT RoR2.dll, so it changes when the game
         updates. It is a build input tied to the game build, and pinned alongside it. -->
    <MMHookDir>$(R2Profile)\BepInEx\plugins\MMHOOK</MMHookDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework -->
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="MMHOOK_RoR2"><HintPath>$(MMHookDir)\MMHOOK_RoR2.dll</HintPath><Private>False</Private></Reference>

    <!-- Game -->
    <Reference Include="RoR2"><HintPath>$(RoR2Managed)\RoR2.dll</HintPath><Private>False</Private></Reference>
    <!-- RoR2.CharacterAI is part of RoR2.dll, not a separate assembly -->
    <Reference Include="Assembly-CSharp"><HintPath>$(RoR2Managed)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="KinematicCharacterController"><HintPath>$(RoR2Managed)\KinematicCharacterController.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="HGCSharpUtils"><HintPath>$(RoR2Managed)\HGCSharpUtils.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LegacyResourcesAPI"><HintPath>$(RoR2Managed)\LegacyResourcesAPI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(RoR2Managed)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath><Private>False</Private></Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine"><HintPath>$(RoR2Managed)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RoR2Managed)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(RoR2Managed)\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(RoR2Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!-- Fail by name when an input is missing, instead of building a different DLL. -->
  <Target Name="RequireReferenceInputs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')"
           Text="Missing build input '%(Reference.Identity)': %(Reference.HintPath). Override RoR2Managed or R2Profile if your install lives elsewhere." />
  </Target>

</Project>
